# 复制为本目录.env；填写自己的值。真实.env不提交。
APP_NAME=insurance-agent
APP_HOST=127.0.0.1
APP_PORT=8001
APP_DEBUG=false
LOGGING_LEVEL=INFO

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=insurance
DB_USER=insurance
# 与deploy/.env中的POSTGRES_PASSWORD一致，自行生成强密码
DB_PASSWORD=

CHAT_MODEL=qwen4-max
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
MINERU_TOKEN=

MILVUS_HOST=127.0.0.1
# docker-compose.local.yml中的本地端口
MILVUS_PORT=19531
MILVUS_COLLECTION=insurance_collection
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSIONS=1024

# 默认关闭远端追踪；主动开启后，问题、回答和工具结果可能上传到自己的LangSmith工作区
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=insurance-agent
LANGSMITH_AGENT_ENVIRONMENT=Local

CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_TRIGGER_TOKENS=12000
CONTEXT_SUMMARY_KEEP_TOKENS=4000
CONTEXT_SUMMARY_MAX_TOKENS=1600
SUPERVISOR_MAX_DELEGATIONS=3
